# ── Required for live runs ──────────────────────────────────────────────────
# Token Factory key: https://tokenfactory.nebius.com → API keys
NEBIUS_API_KEY=
# Tavily key: https://app.tavily.com → API keys (starts with tvly-)
TAVILY_API_KEY=

# ── Model wiring (verified 2026-10-29) ──────────────────────────────────────
# Catalog: https://tokenfactory.nebius.com/model-catalog.md
# Base URL docs: https://docs.tokenfactory.nebius.com/quickstart
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# ── Optional ────────────────────────────────────────────────────────────────
# Force the scripted UI walkthrough even when keys exist (never fakes a live call)
# MOCK_MODE=1
# Durable run history (otherwise .data locally, /tmp on Vercel)
# PAPERTRAIL_DATA_DIR=/absolute/path/to/papertrail-data
